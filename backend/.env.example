SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local development defaults to SQLite. Use MySQL by setting DB_ENGINE below.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

